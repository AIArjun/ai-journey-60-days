# Traffic Violation Detection API - Environment Variables

# Path to YOLOv7 weights (leave empty for demo mode)
MODEL_PATH=

# Device: 'cpu' or 'cuda'
DEVICE=cpu

# Maximum upload file size in MB
MAX_FILE_SIZE_MB=10

# Default confidence threshold (0.1 - 1.0)
DEFAULT_CONFIDENCE=0.5

# Logging level
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
